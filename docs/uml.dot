digraph RuMe {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.7, splines=polyline, fontname="DejaVu Sans", fontsize=18, labelloc=t, label="RuMe | Bridge + Adapter
Production class diagram"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10, color="#64768C", arrowsize=0.9];
  Main [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8392A3"><TR><TD BGCOLOR="#F1F4F7"><FONT POINT-SIZE="10">Client</FONT><BR/><B>Main</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ main(args: String[]): void {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AppRegistry [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8392A3"><TR><TD BGCOLOR="#F1F4F7"><FONT POINT-SIZE="10">Runtime selection</FONT><BR/><B>AppRegistry</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- sources: Map&lt;String, CandidateSource&gt;<BR ALIGN="LEFT"/>- searches: Map&lt;String, HousingSearch&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ load(): void<BR ALIGN="LEFT"/>+ registerSource(source: CandidateSource): void<BR ALIGN="LEFT"/>+ registerSearch(search: HousingSearch): void<BR ALIGN="LEFT"/>+ getSource(code: String): CandidateSource<BR ALIGN="LEFT"/>+ getSearch(code: String): HousingSearch<BR ALIGN="LEFT"/>+ getSourceCodes(): List&lt;String&gt;<BR ALIGN="LEFT"/>+ getSearches(): List&lt;HousingSearch&gt;<BR ALIGN="LEFT"/>- normalize(code: String): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  HousingSearch [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8392A3"><TR><TD BGCOLOR="#EAF1FA"><FONT POINT-SIZE="10">Abstraction / abstract</FONT><BR/><B>HousingSearch</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- source: CandidateSource<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ setSource(source: CandidateSource): void<BR ALIGN="LEFT"/>+ search(city: String, budget: int): List&lt;Candidate&gt; {final}<BR ALIGN="LEFT"/>+ getCode(): String {abstract}<BR ALIGN="LEFT"/>+ getDescription(): String {abstract}<BR ALIGN="LEFT"/>+ getBudgetPrompt(): String {abstract}<BR ALIGN="LEFT"/># matchesBudget(candidateBudget: int, requestedBudget: int): boolean {abstract}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RoommateSearch [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8392A3"><TR><TD BGCOLOR="#EAF1FA"><FONT POINT-SIZE="10">Refined Abstraction</FONT><BR/><B>RoommateSearch</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ getCode(): String<BR ALIGN="LEFT"/>+ getDescription(): String<BR ALIGN="LEFT"/>+ getBudgetPrompt(): String<BR ALIGN="LEFT"/># matchesBudget(candidateBudget: int, requestedBudget: int): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  TenantSearch [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8392A3"><TR><TD BGCOLOR="#EAF1FA"><FONT POINT-SIZE="10">Refined Abstraction</FONT><BR/><B>TenantSearch</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ getCode(): String<BR ALIGN="LEFT"/>+ getDescription(): String<BR ALIGN="LEFT"/>+ getBudgetPrompt(): String<BR ALIGN="LEFT"/># matchesBudget(candidateBudget: int, requestedBudget: int): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CandidateSource [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8392A3"><TR><TD BGCOLOR="#EAF1FA"><FONT POINT-SIZE="10">Implementor / interface</FONT><BR/><B>CandidateSource</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ getCode(): String<BR ALIGN="LEFT"/>+ findByCity(city: String): List&lt;Candidate&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RuMeCandidateSource [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8392A3"><TR><TD BGCOLOR="#EAF1FA"><FONT POINT-SIZE="10">Concrete Implementor</FONT><BR/><B>RuMeCandidateSource</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- candidates: List&lt;Candidate&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ RuMeCandidateSource()<BR ALIGN="LEFT"/>+ getCode(): String<BR ALIGN="LEFT"/>+ findByCity(city: String): List&lt;Candidate&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  UniversityCandidateSource [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8392A3"><TR><TD BGCOLOR="#EAF1FA"><FONT POINT-SIZE="10">Concrete Implementor</FONT><BR/><B>UniversityCandidateSource</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- candidates: Map&lt;String, List&lt;Candidate&gt;&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ UniversityCandidateSource()<BR ALIGN="LEFT"/>+ getCode(): String<BR ALIGN="LEFT"/>+ findByCity(city: String): List&lt;Candidate&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  LegacyCandidateSourceAdapter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8392A3"><TR><TD BGCOLOR="#EAF1FA"><FONT POINT-SIZE="10">Adapter / Concrete Implementor</FONT><BR/><B>LegacyCandidateSourceAdapter</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- service: LegacyHousingService<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ LegacyCandidateSourceAdapter()<BR ALIGN="LEFT"/>+ LegacyCandidateSourceAdapter(service: LegacyHousingService)<BR ALIGN="LEFT"/>+ getCode(): String<BR ALIGN="LEFT"/>+ findByCity(city: String): List&lt;Candidate&gt;<BR ALIGN="LEFT"/>- toCityCode(city: String): int<BR ALIGN="LEFT"/>- toCityName(code: int): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  LegacyHousingService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8392A3"><TR><TD BGCOLOR="#F1F4F7"><FONT POINT-SIZE="10">Adaptee</FONT><BR/><B>LegacyHousingService</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ SUCCESS: int = 0 {static, final}<BR ALIGN="LEFT"/>+ INVALID_REQUEST: int = 1 {static, final}<BR ALIGN="LEFT"/>+ UNAVAILABLE: int = 2 {static, final}<BR ALIGN="LEFT"/>- available: boolean<BR ALIGN="LEFT"/>- records: String[][]<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ LegacyHousingService()<BR ALIGN="LEFT"/>+ LegacyHousingService(available: boolean)<BR ALIGN="LEFT"/>+ loadProfiles(cityCode: int): LegacyResult<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  LegacyResult [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8392A3"><TR><TD BGCOLOR="#F1F4F7"><FONT POINT-SIZE="10">Legacy response / final</FONT><BR/><B>LegacyResult</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- status: int<BR ALIGN="LEFT"/>- records: String[][]<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ LegacyResult(status: int, records: String[][])<BR ALIGN="LEFT"/>+ getStatus(): int<BR ALIGN="LEFT"/>+ getRecords(): String[][]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Candidate [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8392A3"><TR><TD BGCOLOR="#F1F4F7"><FONT POINT-SIZE="10">Domain model</FONT><BR/><B>Candidate</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: int<BR ALIGN="LEFT"/>- name: String<BR ALIGN="LEFT"/>- city: String<BR ALIGN="LEFT"/>- budget: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ Candidate(id: int, name: String, city: String, budget: int)<BR ALIGN="LEFT"/>+ getId(): int<BR ALIGN="LEFT"/>+ getName(): String<BR ALIGN="LEFT"/>+ getCity(): String<BR ALIGN="LEFT"/>+ getBudget(): int<BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CandidateSourceException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8392A3"><TR><TD BGCOLOR="#F1F4F7"><FONT POINT-SIZE="10">Common checked exception</FONT><BR/><B>CandidateSourceException</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ CandidateSourceException(message: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Exception [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#8392A3"><TR><TD BGCOLOR="#F1F4F7"><FONT POINT-SIZE="10">java.lang / external</FONT><BR/><B>Exception</B></TD></TR></TABLE>>];

  { rank=same; Main; AppRegistry; }
  { rank=same; HousingSearch; CandidateSource; }
  { rank=same; RoommateSearch; TenantSearch; RuMeCandidateSource; UniversityCandidateSource; LegacyCandidateSourceAdapter; }
  { rank=same; Candidate; CandidateSourceException; LegacyHousingService; }
  { rank=same; Exception; LegacyResult; }
  Main -> AppRegistry [style=dashed, arrowhead=vee, label="uses"];
  AppRegistry -> HousingSearch [arrowhead=vee, label="searches 0..*"];
  AppRegistry -> CandidateSource [arrowhead=vee, label="sources 0..*"];
  HousingSearch -> CandidateSource [arrowhead=vee, label="source 0..1", constraint=false];
  HousingSearch -> RoommateSearch [dir=back, arrowtail=empty, arrowhead=none];
  HousingSearch -> TenantSearch [dir=back, arrowtail=empty, arrowhead=none];
  CandidateSource -> RuMeCandidateSource [style=dashed, dir=back, arrowtail=empty, arrowhead=none];
  CandidateSource -> UniversityCandidateSource [style=dashed, dir=back, arrowtail=empty, arrowhead=none];
  CandidateSource -> LegacyCandidateSourceAdapter [style=dashed, dir=back, arrowtail=empty, arrowhead=none];
  LegacyCandidateSourceAdapter -> LegacyHousingService [arrowhead=vee, label="service 1"];
  LegacyHousingService -> LegacyResult [style=dashed, arrowhead=vee, label="returns"];
  HousingSearch -> Candidate [style=dashed, arrowhead=vee, label="returns / filters", minlen=2];
  CandidateSource -> CandidateSourceException [style=dashed, arrowhead=vee, label="findByCity throws", minlen=2];
  CandidateSourceException -> Exception [arrowhead=empty];
}
